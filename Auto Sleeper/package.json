{
  "name": "auto-sleeper",
  "version": "1.0.0",
  "description": "",
  "main": "src/main.js",
  "scripts": {
    "vite-dev": "vite",
    "electron-dev": "wait-on tcp:5173 && cross-env NODE_ENV=development nodemon --watch src/main.js --watch src/services --watch src/preload.js --exec \"electron .\"",
    "dev": "concurrently \"npm run vite-dev\" \"npm run electron-dev\"",
    "build": "vite build",
    "start": "npm run build && electron .",
    "package": "npm run build && electron-builder --win"
  },
  "build": {
    "appId": "com.autosleeper.app",
    "productName": "Auto Sleeper",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "src/main.js",
      "src/preload.js",
      "src/services/**/*",
      "src/data/**/*"
    ],
    "win": {
      "target": "nsis"
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.5.0",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "electron": "^42.3.3",
    "electron-builder": "^26.15.2",
    "nodemon": "^3.1.14",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.0",
    "vite": "^8.0.16",
    "wait-on": "^9.0.10"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@fontsource-variable/geist": "^5.2.9",
    "@tabler/icons-react": "^3.44.0",
    "@tailwindcss/vite": "^4.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lenis": "^1.3.23",
    "lucide-react": "^1.17.0",
    "motion": "^12.40.0",
    "radix-ui": "^1.5.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "shadcn": "^4.11.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  }
}
